# Copy to .env and fill with your Supabase project values (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated emails that always open /dashboard/admin (must match Supabase admin_allowlist for API access)
# VITE_SITE_OWNER_EMAILS=you@example.com
